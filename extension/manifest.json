{
  "manifest_version": 3,
  "name": "Continuum AI",
  "version": "1.0.0",
  "description": "Never lose your AI flow state. Save project context and switch between Claude, ChatGPT, and Gemini in one click.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://grok.x.com/*",
    "https://www.perplexity.ai/*",
    "http://localhost:8000/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["utils/inject.js", "content/chatgpt.js"]
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["utils/inject.js", "content/claude.js"]
    },
    {
      "matches": ["http://localhost:3000/auth/extension-bridge*"],
      "js": ["content/auth-bridge.js"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
